{
  "manifest_version": 3,
  "name": "Cookie Extract",
  "version": "0.1.0",
  "description": "按配置的键名提取当前网站的 Cookie，一键复制。",
  "permissions": [
    "cookies",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Cookie Extract",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
